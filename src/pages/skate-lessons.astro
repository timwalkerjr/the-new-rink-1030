---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Skate Lessons – The New Rink';
const pageDescription =
  'Learn to skate with us. Skate Lessons – The New Rink – Shelby Township, Michigan. Receive a coupon for 10% off skate purchases in our Pro shop when you register for lessons!';
---

<BaseLayout title={pageTitle} description={pageDescription} headerVariant="transparent">
  <section class="skate-hero" data-ps="src/pages/skate-lessons.astro:okbs64">
    <div class="skate-container" data-ps="src/pages/skate-lessons.astro:4mjlbl">
      <p class="skate-eyebrow" data-ps="src/pages/skate-lessons.astro:glmtbx">Learn to skate with us</p>
      <h1 class="skate-hero__title" data-ps="src/pages/skate-lessons.astro:w6hzx3">Skate Lessons</h1>
    </div>
  </section>

  <section class="skate-main" data-ps="src/pages/skate-lessons.astro:okbs63">
    <div class="skate-container skate-grid" data-ps="src/pages/skate-lessons.astro:4mjlbk">
      <div class="skate-prose" data-ps="src/pages/skate-lessons.astro:4mjlbj">
        <h2 data-ps="src/pages/skate-lessons.astro:hi32pd">Skate Lessons – The New Rink – Shelby Township, Michigan</h2>
        <p data-ps="src/pages/skate-lessons.astro:glmtby"><strong>Receive a coupon for 10% off skate purchases in our Pro shop when you register for lessons!&nbsp;&nbsp;Lessons taught by instructors Sheryl Bower &amp; Theresa Golcheff.</strong></p>

        <h2 data-ps="src/pages/skate-lessons.astro:hi32pe">BEGINNER INSTRUCTION &amp; PRACTICE</h2>
        <hr>
        <p data-ps="src/pages/skate-lessons.astro:glmtbz"><strong>Roller Skating/Rollerblading Class will be held on Saturdays from 12:00pm – 12:30pm or Tuesdays from 5:30pm – 6:00pm for five consecutive weeks.</strong></p>
        <p data-ps="src/pages/skate-lessons.astro:glmtc0"><strong>Intermediate Roller Blading/Speed Class will be held on Saturdays from 9:30am – 10:00am or Thursdays from 5:30pm – 6:00pm for five consecutive weeks.</strong></p>
        <p data-ps="src/pages/skate-lessons.astro:glmtcm">Only class members who are enrolled in the Learn to Skate session are allowed to have roller skates or roller blades on during the lesson time.</p>
        <p data-ps="src/pages/skate-lessons.astro:glmtcn">All participants will receive a 5 regular session punch card to attend regularly scheduled public session.</p>

        <h3 data-ps="src/pages/skate-lessons.astro:2to5h4"><strong>2026 – 2027 Session Dates</strong></h3>
        <hr>

        <h4 data-ps="src/pages/skate-lessons.astro:buqrql">BEGINNER LESSONS</h4>

        <h4 data-ps="src/pages/skate-lessons.astro:buqrqk">Saturday Class 12:00-12:30pm</h4>
        <ul>
          <li data-ps="src/pages/skate-lessons.astro:i91z2w">Session #1 September 12 – October 10</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z2x">Session #2 October 17 – November 14</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z2y">Session #3 November 21 – December 19</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z2z">Session #4 January 2 – January 30</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z30">Session #5 February 6 – March 6</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z31">Session #6 March 13 – April 10</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3n">Session #7 April 17 – May 15</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3o">Session #8 May 22 – June 26 (no class 5/29)</li>
        </ul>

        <h4 data-ps="src/pages/skate-lessons.astro:buqrqj">Tuesday Class 5:30 – 6:00pm</h4>
        <ul>
          <li data-ps="src/pages/skate-lessons.astro:i91z3p">Session #1 September 8 – October 6</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3q">Session #2 October 13 – November 10</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3r">Session #3 November 17 – December 15</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3s">Session #4 January 5 – February 2</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3t">Session #5 February 9 – March 9</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3u">Session #6 March 16 – April 20 (no class 3/30)</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3v">Session #7 April 27 – May 25</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z3w">Session #8 June 1 – June 29</li>
        </ul>

        <p data-ps="src/pages/skate-lessons.astro:glmtco">INTERMEDIATE ROLLERBLADE LESSONS</p>
        <p data-ps="src/pages/skate-lessons.astro:glmtcp"><strong>MUST HAVE LEVEL 1 LEARN TO SKATE CERTIFICATE</strong></p>

        <p data-ps="src/pages/skate-lessons.astro:glmtcq"><strong>Saturday Class 9:30-10:00am</strong></p>
        <ul>
          <li data-ps="src/pages/skate-lessons.astro:i91z4i">Session #1 September 12 – October 10</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z4j">Session #2 October 17 – November 14</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z4k">Session #3 November 21 – December 19</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z4l">Session #4 January 2 – January 30</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z4m">Session #5 February 6 – March 6</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z4n">Session #6 March 13 – April 10</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z4o">Session #7 April 17 – May 15</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z4p">Session #8 May 22 – June 26 (no class 5/29)</li>
        </ul>

        <h4 data-ps="src/pages/skate-lessons.astro:buqrqi">Thursday Class 5:30 – 6:00pm</h4>
        <ul>
          <li data-ps="src/pages/skate-lessons.astro:i91z4q">Session #1 September 10 – October 8</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z4r">Session #2 October 15 – November 12</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z5d">Session #3 November 19 – December 17 (4 weeks $56)</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z5e">Session #4 January 7 – February 4</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z5f">Session #5 February 11 – March 11</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z5g">Session #6 March 18 – April 15</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z5h">Session #7 April 22 – May 30</li>
          <li data-ps="src/pages/skate-lessons.astro:i91z5i">Session #8 May 27 – June 24</li>
        </ul>

        <h2 data-ps="src/pages/skate-lessons.astro:hi32pf">SPEED SKATING LESSONS – BEGINNER Instruction &amp; Practice</h2>
        <hr>
        <p data-ps="src/pages/skate-lessons.astro:glmtcr">The class will teach the basics of speed skating including starts, cornering, passing, technique and relays. Skaters should arrive at least 15 minutes early to check in and get their roller blades on.</p>
        <p data-ps="src/pages/skate-lessons.astro:glmtcs"><strong>SKILL REQUIREMENTS</strong>: Skater must have good balance and be able to cross over on turns. Must have completion of the Tuesday or Saturday beginner class</p>
        <p data-ps="src/pages/skate-lessons.astro:glmtct"><strong>EQUIPMENT REQUIREMENTS</strong>:&nbsp; Helmet and your own inline skates (limited inline rentals available).</p>
        <p data-ps="src/pages/skate-lessons.astro:glmtcu">Class will be held on<strong>&nbsp;Saturdays from 8:45am – 9:45am</strong>.&nbsp; Only class members who are enrolled in the Inline Speed Skating Class are allowed to have roller blades on during the lesson time.&nbsp; Please call before your first visit to verify time.</p>

        <h3 data-ps="src/pages/skate-lessons.astro:2to5hq">CLASS ADVANCEMENT</h3>
        <p data-ps="src/pages/skate-lessons.astro:glmtcv">Skaters are evaluated by the instructor to determine if their skills have developed enough to join the SS Racing Inline Speed Team based out of Skatin Station in Canton.</p>
        <p data-ps="src/pages/skate-lessons.astro:glmtdh"><strong>Our speed skating classes are taught by highly qualified professional skating instructors. For more information please email Ken Yee at kyee@thenewrink.com or call (586) 731-5006.</strong></p>

        <h3 data-ps="src/pages/skate-lessons.astro:2to5hr">REGISTRATION PROCEDURE</h3>
        <p data-ps="src/pages/skate-lessons.astro:glmtdi">Each enrollee must register and pay class fees prior to attending the first class. To register for a session you can stop by The New Rink to fill out your registration form and pay the registration fee. Registration is open to ALL AGES and SKILL LEVELS.</p>

        <h3 data-ps="src/pages/skate-lessons.astro:2to5hs">FEES</h3>
        <p data-ps="src/pages/skate-lessons.astro:glmtdj">Fees are based on a five-week Inline Speed Skating Session. Class sessions are listed on the back. Fee includes roller blade rental. There are no make up classes and no refunds will be given.</p>

        <h2 data-ps="src/pages/skate-lessons.astro:hi32pg">Saturday Lesson $70</h2>
        <hr>
        <p data-ps="src/pages/skate-lessons.astro:glmtdk">The Beginner Inline Speed sessions are taught by highly qualified professional skating instructors.&nbsp;<strong>For more information please email us at kyee@thenewrink.com or stop by to sign up for the next session!</strong></p>

        <h4 data-ps="src/pages/skate-lessons.astro:buqrqh">Saturdays Class 8:45am – 9:45am</h4>
      </div>

      <aside class="skate-side" data-ps="src/pages/skate-lessons.astro:wxwrzx">
        <img
          class="skate-side__img"
          src="https://pagesmith-cdn.com/0b4329bf/images/Edruskate-learn-to-roller-skate-9026fc-500.webp"
          alt="Skate Lessons at The New Rink"
          width="500"
          height="333"
          loading="lazy" data-ps="src/pages/skate-lessons.astro:yhsjyz" />
        <h2 class="skate-side__title" data-ps="src/pages/skate-lessons.astro:hi32ph">Necessary Documents</h2>
        <a
          class="skate-btn"
          href="https://thenewrink.com/wp-content/uploads/2026/09/web-sign-up-form.pdf"
          target="_blank"
          rel="noopener"
         data-ps="src/pages/skate-lessons.astro:320srz">Printable Sign-up Form</a>
      </aside>
    </div>
  </section>

  <section class="skate-cta bg-dark-background" data-ps="src/pages/skate-lessons.astro:okbs62">
    <img
      class="skate-cta__bg"
      src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp"
      alt="Roller skating party at The New Rink"
      width="360"
      height="240"
      loading="lazy" data-ps="src/pages/skate-lessons.astro:yhsjyy" />
    <div class="skate-cta__inner" data-ps="src/pages/skate-lessons.astro:4mjlbi">
      <p class="skate-cta__tagline" data-ps="src/pages/skate-lessons.astro:2trkr7">Fun with family, friends, co-workers, and more</p>
      <h2 class="skate-cta__title" data-ps="src/pages/skate-lessons.astro:hi32pi">Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.</h2>
      <p class="skate-cta__text" data-ps="src/pages/skate-lessons.astro:2trkr8">We have many packages to make your party a memorable and fun event.</p>
      <a
        class="skate-cta__btn"
        href="https://thenewrink.pcsparty.com/bookings/index.asp"
        target="_blank"
        rel="noopener"
       data-ps="src/pages/skate-lessons.astro:320ss0">Book a Party Now</a>
    </div>
  </section>
</BaseLayout>

<style>
  .skate-container {
    max-width: 1344px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .skate-hero {
    background: var(--color-accent);
    color: #fff;
    padding: calc(var(--nav-height) + 6rem) 0 4.5rem;
  }
  .skate-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-border);
  }
  .skate-hero__title {
    margin: 0;
    font-size: clamp(2.25rem, 1.6rem + 1.6vw, 3rem);
    line-height: 1.2;
    color: #fff;
  }

  .skate-main {
    background: #f3f3f3;
    padding: 7rem 0;
  }
  .skate-grid {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 1024px) {
    .skate-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  .skate-prose {
    color: var(--color-foreground);
    font-size: 1rem;
    line-height: 1.6;
  }
  .skate-prose h2,
  .skate-prose h3,
  .skate-prose h4 {
    color: #000;
    line-height: 1.2;
  }
  .skate-prose h2 {
    font-size: clamp(1.75rem, 1.2rem + 1.2vw, 2.7rem);
    margin: 2.25rem 0 1rem;
  }
  .skate-prose h3 {
    font-size: clamp(1.5rem, 1.2rem + 0.8vw, 2rem);
    margin: 2.25rem 0 0.75rem;
  }
  .skate-prose h4 {
    font-size: clamp(1.25rem, 1.05rem + 0.5vw, 1.625rem);
    margin: 1.75rem 0 0.75rem;
  }
  .skate-prose > :first-child {
    margin-top: 0;
  }
  .skate-prose hr {
    border: 0;
    border-top: 2px solid #9a9a9a;
    margin: 0 0 1.25rem;
  }
  .skate-prose p {
    margin: 0 0 1rem;
  }
  .skate-prose strong {
    font-weight: 700;
    color: #000;
  }
  .skate-prose ul {
    list-style: disc;
    padding-left: 1.75rem;
    margin: 0 0 1.25rem;
  }
  .skate-prose li {
    line-height: 2;
  }

  .skate-side {
    min-width: 0;
  }
  .skate-side__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .skate-side__title {
    margin: 1.5rem 0 1.25rem;
    font-size: clamp(1.5rem, 1.2rem + 0.8vw, 1.9rem);
    line-height: 1.2;
    color: #000;
  }
  .skate-btn {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    border-radius: 999px;
    padding: 0.875rem 1.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .skate-btn:hover,
  .skate-btn:focus-visible {
    background: var(--color-primary-hover);
  }

  .skate-cta {
    position: relative;
    overflow: hidden;
    color: #fff;
    padding: 7rem 0;
    text-align: center;
  }
  .skate-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .skate-cta__inner {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .skate-cta__tagline {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-border);
  }
  .skate-cta__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.5625rem);
    line-height: 1.2;
    color: #fff;
  }
  .skate-cta__text {
    margin: 0 0 2rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }
  .skate-cta__btn {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    border-radius: 4px;
    padding: 0.875rem 1.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .skate-cta__btn:hover,
  .skate-cta__btn:focus-visible {
    background: var(--color-primary-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .skate-btn,
    .skate-cta__btn {
      transition: none;
    }
  }
</style>
