---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Page not found – The New Rink';
---

<BaseLayout title={title} description="" headerVariant="transparent">
  <section class="bg-background" data-ps="src/pages/schedule/saturday.astro:s178rj">
    <div class="mx-auto flex w-full max-w-[1136px] flex-col items-start px-7 py-[200px] text-left" data-ps="src/pages/schedule/saturday.astro:sfztx4">
      <h1
        class="mb-[11px] text-[clamp(4rem,2.5rem+8vw,8rem)] font-bold leading-none text-[#550172]"
       data-ps="src/pages/schedule/saturday.astro:5qrx1q">
        404
      </h1>
      <p class="mb-[15px] text-lg text-foreground" data-ps="src/pages/schedule/saturday.astro:bplbd3">not found</p>
      <div class="flex" data-ps="src/pages/schedule/saturday.astro:sfztx3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          id="icon-sad"
          viewBox="0 0 32 32"
          width="16"
          height="16"
          aria-hidden="true"
          class="fill-black"
        >
          <path
            d="M16 32c8.837 0 16-7.163 16-16s-7.163-16-16-16-16 7.163-16 16 7.163 16 16 16zM16 3c7.18 0 13 5.82 13 13s-5.82 13-13 13-13-5.82-13-13 5.82-13 13-13zM8 10c0-1.105 0.895-2 2-2s2 0.895 2 2c0 1.105-0.895 2-2 2s-2-0.895-2-2zM20 10c0-1.105 0.895-2 2-2s2 0.895 2 2c0 1.105-0.895 2-2 2s-2-0.895-2-2zM9.997 24.398l-2.573-1.544c1.749-2.908 4.935-4.855 8.576-4.855s6.827 1.946 8.576 4.855l-2.573 1.544c-1.224-2.036-3.454-3.398-6.003-3.398s-4.779 1.362-6.003 3.398z"
          />
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>
