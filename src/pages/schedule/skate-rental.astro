---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Page not found – The New Rink';
---

<BaseLayout title={pageTitle} description="" headerVariant="transparent">
  <section class="bg-background" data-ps="src/pages/schedule/skate-rental.astro:dxvw3i">
    <div class="mx-auto flex w-full max-w-[1136px] flex-col items-start px-7 pt-[200px] pb-[200px] text-left max-md:pt-28 max-md:pb-28" data-ps="src/pages/schedule/skate-rental.astro:zcq7px">
      <h1
        class="mb-[11px] text-secondary-foreground"
        style="font-size: clamp(5rem, 4rem + 4vw, 8rem); line-height: 1; font-weight: 700;"
       data-ps="src/pages/schedule/skate-rental.astro:ton6sx">
        404
      </h1>
      <p class="mb-[15px] text-lg text-foreground" data-ps="src/pages/schedule/skate-rental.astro:8her8q">not found</p>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        id="icon-sad"
        viewBox="0 0 32 32"
        width="16"
        height="16"
        aria-hidden="true"
        focusable="false"
        class="block fill-black"
      >
        <path d="M16 32c8.837 0 16-7.163 16-16s-7.163-16-16-16-16 7.163-16 16 7.163 16 16 16zM16 3c7.18 0 13 5.82 13 13s-5.82 13-13 13-13-5.82-13-13 5.82-13 13-13zM8 10c0-1.105 0.895-2 2-2s2 0.895 2 2c0 1.105-0.895 2-2 2s-2-0.895-2-2zM20 10c0-1.105 0.895-2 2-2s2 0.895 2 2c0 1.105-0.895 2-2 2s-2-0.895-2-2zM9.997 24.398l-2.573-1.544c1.749-2.908 4.935-4.855 8.576-4.855s6.827 1.946 8.576 4.855l-2.573 1.544c-1.224-2.036-3.454-3.398-6.003-3.398s-4.779 1.362-6.003 3.398z"></path>
      </svg>
    </div>
  </section>
</BaseLayout>
