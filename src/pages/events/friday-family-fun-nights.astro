---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Friday & Saturday Family Fun Nights – The New Rink';
const description =
  'Friday & Saturday Family Fun Nights at The New Rink: 7:00 p.m. - 10:00 p.m., $14 Friday / $15 Saturday, with a Friday Night Family Rate of 4 for $60.';
const bookingUrl = 'https://thenewrink.pcsparty.com/bookings/index.asp';
---

<BaseLayout title={title} description={description} headerVariant="transparent">
  <!-- Hero -->
  <section class="bg-[#550172] pt-40 pb-14 text-white md:pt-44 md:pb-20" data-ps="src/pages/events/friday-family-fun-nights.astro:ixk06m">
    <div class="mx-auto max-w-[1344px] px-7" data-ps="src/pages/events/friday-family-fun-nights.astro:9xgg1v">
      <p class="text-base text-[#fcc4a1]" data-ps="src/pages/events/friday-family-fun-nights.astro:10fr8m">Special events</p>
      <h1 class="mt-3 text-h1 font-normal leading-[1.2] text-white" data-ps="src/pages/events/friday-family-fun-nights.astro:w5b40n">Friday &amp; Saturday Family Fun Nights</h1>
    </div>
  </section>

  <!-- Event details -->
  <section class="bg-[#f3f3f3] py-20 md:py-28" data-ps="src/pages/events/friday-family-fun-nights.astro:ixk06l">
    <div class="mx-auto grid max-w-[1344px] gap-12 px-7 lg:grid-cols-[minmax(0,1fr)_427px] lg:gap-16" data-ps="src/pages/events/friday-family-fun-nights.astro:9xgg1u">
      <div class="prose prose-neutral max-w-none" data-ps="src/pages/events/friday-family-fun-nights.astro:9xgg1t">
        <h2 class="text-h2 font-normal leading-[1.2] text-black" data-ps="src/pages/events/friday-family-fun-nights.astro:o7e0qv">Join the fun</h2>
        <p class="mt-6 text-xl leading-[34px] text-[#550172]" data-ps="src/pages/events/friday-family-fun-nights.astro:10fr8n">Every Friday &amp; Saturday Night!</p>
        <p class="mt-4 text-xl leading-[34px] text-[#550172]" data-ps="src/pages/events/friday-family-fun-nights.astro:10fr8o">7:00 p.m. - 10:00 p.m.</p>
        <p class="mt-4 text-xl leading-[34px] text-[#550172]" data-ps="src/pages/events/friday-family-fun-nights.astro:10fr8p">$14 Friday / $15 Saturday</p>
        <p class="mt-6 text-base leading-[27.2px] text-[#404040]" data-ps="src/pages/events/friday-family-fun-nights.astro:10fr8q">
          Friday Night Family Rate: 4 for $60 (must include 1 parent and 1 child) includes choice of rental if needed, Bounce Zone (12 &amp; under), 1 whole pizza and four 16 oz drinks. Must present deal at the time of purchase to be valid)
        </p>
      </div>

      <aside class="flex flex-col items-start gap-6" data-ps="src/pages/events/friday-family-fun-nights.astro:6yi7rp">
        <img
          class="block h-auto w-full max-w-[427px] rounded-lg"
          src="https://pagesmith-cdn.com/0b4329bf/images/Friday-Family-Fun-Skate-1-scaled-1-3adcda-1536.webp"
          alt="Friday &amp; Saturday Family Fun Nights flyer"
          width="1536"
          height="768"
          loading="lazy" data-ps="src/pages/events/friday-family-fun-nights.astro:v8en9v" />
        <a
          class="inline-block rounded-full bg-[#f76d18] px-7 py-3.5 text-sm font-semibold tracking-[0.5px] text-white transition-colors hover:bg-[#d45608] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#f76d18]"
          href={bookingUrl}
          target="_blank"
          rel="noopener"
         data-ps="src/pages/events/friday-family-fun-nights.astro:84dnxt">
          Book this event
        </a>
      </aside>
    </div>
  </section>

  <!-- Party call to action -->
  <section class="relative isolate overflow-hidden bg-[#270034] py-28 text-center text-white" data-ps="src/pages/events/friday-family-fun-nights.astro:ixk06k">
    <img
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp"
      alt="Roller skating party at The New Rink"
      width="360"
      height="200"
      loading="lazy" data-ps="src/pages/events/friday-family-fun-nights.astro:v8en9w" />
    <div class="mx-auto max-w-4xl px-7" data-ps="src/pages/events/friday-family-fun-nights.astro:9xgg1s">
      <p class="text-sm font-semibold uppercase leading-[19.6px] text-[#fcc4a1]" data-ps="src/pages/events/friday-family-fun-nights.astro:10fr8r">
        Fun with family, friends, co-workers, and more
      </p>
      <h2 class="mt-4 text-[clamp(2rem,1rem+3.2vw,3.5625rem)] font-normal leading-[1.2] text-white" data-ps="src/pages/events/friday-family-fun-nights.astro:o7e0qw">
        Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.
      </h2>
      <p class="mt-6 text-lg leading-[27px] text-white/90" data-ps="src/pages/events/friday-family-fun-nights.astro:10fr8s">
        We have many packages to make your party a memorable and fun event.
      </p>
      <a
        class="mt-10 inline-block rounded bg-[#f76d18] px-7 py-3.5 text-lg font-semibold text-white transition-colors hover:bg-[#d45608] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        href={bookingUrl}
        target="_blank"
        rel="noopener"
       data-ps="src/pages/events/friday-family-fun-nights.astro:84dnxu">
        Book a Party Now
      </a>
    </div>
  </section>
</BaseLayout>
