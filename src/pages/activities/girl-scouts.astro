---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Girl Scouts – The New Rink';
const pageDescription =
  'Activities at The New Rink Girl Scouts Bring Your Troop Roller Skating!! Ask about our annual Spectacular Scout Skate! Customized Packages for groups LARGE or Small.';
---

<BaseLayout headerVariant="transparent" title={pageTitle} description={pageDescription}>
  <!-- Purple page header -->
  <section class="bg-[#550172] pt-40 pb-14 md:pt-44 md:pb-16" data-ps="src/pages/activities/girl-scouts.astro:swrha4">
    <div class="mx-auto w-[min(1344px,calc(100%-2.5rem))]" data-ps="src/pages/activities/girl-scouts.astro:c6o8h3">
      <p class="text-base text-[#fcc4a1]" data-ps="src/pages/activities/girl-scouts.astro:hxw5vi">Activities at The New Rink</p>
      <h1 class="mt-2 text-4xl font-normal leading-tight text-white md:text-[48px] md:leading-[57.6px]" data-ps="src/pages/activities/girl-scouts.astro:t550u9">Girl Scouts</h1>
    </div>
  </section>

  <!-- Troop skating details -->
  <section class="bg-[#f3f3f3] py-16 md:py-28" data-ps="src/pages/activities/girl-scouts.astro:swrha5">
    <div class="mx-auto grid w-[min(1344px,calc(100%-2.5rem))] items-start gap-12 lg:grid-cols-[1fr_427px] lg:gap-16" data-ps="src/pages/activities/girl-scouts.astro:c6o8h4">
      <div class="min-w-0" data-ps="src/pages/activities/girl-scouts.astro:c6o8h5">
        <h2 class="text-[32px] leading-tight text-black md:text-[40px] md:leading-[50px]" data-ps="src/pages/activities/girl-scouts.astro:r7k3x9">Bring Your Troop Roller Skating!!</h2>
        <hr class="my-3 border-0 border-t border-[#808080]" />
        <p class="text-base leading-[27.2px] text-[#404040]" data-ps="src/pages/activities/girl-scouts.astro:hxw5vj">Ask about our annual Spectacular Scout Skate!&nbsp;Customized Packages for groups LARGE or Small.</p>
        <ul class="mt-2 list-disc pl-6 text-base leading-[27.2px] text-[#404040]">
          <li data-ps="src/pages/activities/girl-scouts.astro:ryj0f0">Roller Skating</li>
          <li data-ps="src/pages/activities/girl-scouts.astro:ryj0f1">Regular/Inline Rental</li>
          <li data-ps="src/pages/activities/girl-scouts.astro:ryj0f2">Fun Patch</li>
          <li data-ps="src/pages/activities/girl-scouts.astro:ryj0f3">Bounce Zone</li>
          <li data-ps="src/pages/activities/girl-scouts.astro:ryj0f4">Arcade</li>
          <li data-ps="src/pages/activities/girl-scouts.astro:ryj0fq">Banquet Center</li>
        </ul>
        <p class="mt-6 text-base font-bold leading-[27.2px] text-[#404040]" data-ps="src/pages/activities/girl-scouts.astro:hxw5vk">For pricing information &amp; available dates call or email kyee@thenewrink.com or by phone at 586-731-5006</p>
      </div>
      <aside class="w-full" data-ps="src/pages/activities/girl-scouts.astro:tudkd1">
        <img
          class="block aspect-[3/2] w-full rounded-lg object-cover"
          src="https://pagesmith-cdn.com/0b4329bf/images/shutterstock_2540215587-3c7c84-1000.webp"
          alt="Girl Scouts at The New Rink"
          width="1000"
          height="667"
          loading="lazy" data-ps="src/pages/activities/girl-scouts.astro:hokq6b" />
      </aside>
    </div>
  </section>

  <!-- Party call-to-action band -->
  <section class="relative isolate overflow-hidden bg-[#270034] py-20 text-center text-white md:py-28" data-ps="src/pages/activities/girl-scouts.astro:swrha6">
    <img
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-60"
      src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp"
      alt="Roller skating party at The New Rink"
      width="360"
      height="240"
      loading="lazy" data-ps="src/pages/activities/girl-scouts.astro:hokq6a" />
    <div class="mx-auto flex w-[min(1344px,calc(100%-2.5rem))] flex-col items-center" data-ps="src/pages/activities/girl-scouts.astro:c6o8h6">
      <p class="text-sm font-semibold uppercase leading-[19.6px] tracking-[0.28px] text-[#fcc4a1]" data-ps="src/pages/activities/girl-scouts.astro:hxw5vl">Fun with family, friends, co-workers, and more</p>
      <h2 class="mx-auto mt-4 max-w-[960px] text-[clamp(2.25rem,1.4rem+3vw,3.5625rem)] leading-[1.2] text-white" data-ps="src/pages/activities/girl-scouts.astro:r7k3xa">Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.</h2>
      <p class="mt-6 text-lg leading-[27px] text-white/90" data-ps="src/pages/activities/girl-scouts.astro:hxw5vm">We have many packages to make your party a memorable and fun event.</p>
      <a
        class="mt-10 inline-block rounded-[4px] bg-primary px-7 py-3.5 text-[18px] font-semibold leading-[25.2px] text-white transition-colors hover:bg-primary-hover"
        href="https://thenewrink.pcsparty.com/bookings/index.asp"
        target="_blank"
        rel="noopener"
       data-ps="src/pages/activities/girl-scouts.astro:p1u2lb">
        Book a Party Now
      </a>
    </div>
  </section>
</BaseLayout>
