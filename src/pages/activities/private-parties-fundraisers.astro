---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Private Parties / Fundraisers – The New Rink';
const pageDescription =
  'Activities at The New Rink Private Parties / Fundraisers. Private Group Packages, Option 1: PRIVATE SKATE PACKAGE and Option 2: PRIVATE SKATE AND BOUNCE PACKAGE.';

const sideImageUrl = 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-022-0e3d6a-359.webp';
const ctaImageUrl = 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp';
const guestListUrl = 'https://thenewrink.com/wp-content/uploads/2026/09/The-New-Rink-Guest-List-Online-2023.pdf';
const bookingUrl = 'https://thenewrink.pcsparty.com/bookings/index.asp';
---

<BaseLayout title={pageTitle} description={pageDescription} headerVariant="transparent">
  <!-- Purple page header -->
  <section class="bg-accent pt-[calc(var(--nav-height)+4.5rem)] pb-14 md:pb-20" data-ps="src/pages/activities/private-parties-fundraisers.astro:v4ernv">
    <div class="mx-auto w-full max-w-[1344px] px-7" data-ps="src/pages/activities/private-parties-fundraisers.astro:hl02bu">
      <p class="text-base text-border" data-ps="src/pages/activities/private-parties-fundraisers.astro:fc54wf">Activities at The New Rink</p>
      <h1 class="mt-3 font-display text-h1 leading-[1.2] text-white" data-ps="src/pages/activities/private-parties-fundraisers.astro:ovznkc">Private Parties / Fundraisers</h1>
    </div>
  </section>

  <!-- Package details and sidebar -->
  <section class="bg-[rgb(243,243,243)] py-16 md:py-28" data-ps="src/pages/activities/private-parties-fundraisers.astro:v4ernw">
    <div class="mx-auto grid w-full max-w-[1344px] gap-12 px-7 lg:grid-cols-[minmax(0,1fr)_427px] lg:gap-16" data-ps="src/pages/activities/private-parties-fundraisers.astro:hl02bt">
      <div class="min-w-0 text-foreground" data-ps="src/pages/activities/private-parties-fundraisers.astro:hl02bs">
        <h2 class="font-display text-[2.5rem] leading-[1.25] text-black" data-ps="src/pages/activities/private-parties-fundraisers.astro:a7kqcp">
          <strong class="font-normal">Private Group Packages</strong>
        </h2>

        <h3 class="mt-10 font-display text-[2rem] leading-[1.3] text-black" data-ps="src/pages/activities/private-parties-fundraisers.astro:4gu6ux">Option 1: PRIVATE SKATE PACKAGE</h3>
        <ul class="mt-4 list-disc space-y-1.5 pl-6 text-base leading-[27px]">
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjms2">Facility is reserved solely for you and your guests.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmso">Private two-hour session. Additional hour of time is $1.00 per skater.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmsp">Regular skate rental, Roller blades or speed skates are $3.00</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmsq">Staff is provided to supervise and run the event.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmsr">Snack bar will be open for your guests to make purchases.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmss">Food packages available. Additional $3.50 per person to include a slice of pizza &amp; drink or $3.00 per person to include a hot dog &amp; drink.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmst">No charge for outside food if food package is purchased.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmsu">Outside food upon approval but no beverages allowed.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmsv">Deposit and signed agreement required.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmsw">Call for available dates.</li>
        </ul>

        <h4 class="mt-8 font-display text-[1.625rem] leading-[1.3] text-black" data-ps="src/pages/activities/private-parties-fundraisers.astro:j59436">Party Pricing:</h4>
        <ul class="mt-3 list-disc space-y-1.5 pl-6 text-base leading-[27px]">
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmsx">Any open date/time completed by 10:00PM</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmtj">Minimum of 100 guests</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmtk">$8.00 PER PERSON</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmtl">$3.00 Rental skates</li>
        </ul>

        <h4 class="mt-8 font-display text-[1.625rem] leading-[1.3] text-black" data-ps="src/pages/activities/private-parties-fundraisers.astro:j59435">Late Night Parties</h4>
        <ul class="mt-3 list-disc space-y-1.5 pl-6 text-base leading-[27px]">
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmtm">10:00pm or later</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmtn">Minimum of 100 guests</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmto">CALL FOR PRICING</li>
        </ul>

        <h3 class="mt-14 font-display text-[2rem] leading-[1.3] text-black" data-ps="src/pages/activities/private-parties-fundraisers.astro:4gu6uw">Option 2: PRIVATE SKATE AND BOUNCE PACKAGE</h3>

        <h4 class="mt-8 font-display text-[1.625rem] leading-[1.3] text-black" data-ps="src/pages/activities/private-parties-fundraisers.astro:j5942j">Party Pricing:</h4>
        <ul class="mt-3 list-disc space-y-1.5 pl-6 text-base leading-[27px]">
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmtp">Any open date/time completed by 10:00 p.m.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmtq">Minimum of 100 guests</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmtr">$12.00 PER PERSON skate and bounce.</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmts">$3.00 Rental skates</li>
        </ul>

        <h4 class="mt-8 font-display text-[1.625rem] leading-[1.3] text-black" data-ps="src/pages/activities/private-parties-fundraisers.astro:j5942i">Late Night Parties</h4>
        <ul class="mt-3 list-disc space-y-1.5 pl-6 text-base leading-[27px]">
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmue">10:00pm or later</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmuf">Minimum of 100 guests</li>
          <li data-ps="src/pages/activities/private-parties-fundraisers.astro:ayjmug">CALL FOR PRICING</li>
        </ul>
      </div>

      <aside class="min-w-0" data-ps="src/pages/activities/private-parties-fundraisers.astro:kstcrg">
        <img
          src={sideImageUrl}
          alt="Private Parties / Fundraisers at The New Rink"
          width="427"
          height="285"
          loading="lazy"
          class="block aspect-[427/285] w-full rounded-lg object-cover" data-ps="src/pages/activities/private-parties-fundraisers.astro:knlbcp" />
        <h2 class="mt-8 font-display text-[1.875rem] leading-[1.3] text-black" data-ps="src/pages/activities/private-parties-fundraisers.astro:a7kqcq">Necessary Documents</h2>
        <div class="mt-6" data-ps="src/pages/activities/private-parties-fundraisers.astro:hl02br">
          <a
            href={guestListUrl}
            target="_blank"
            rel="noopener"
            class="inline-block rounded-full bg-primary px-7 py-3.5 text-sm font-semibold tracking-[0.5px] text-white transition-colors hover:bg-primary-hover"
           data-ps="src/pages/activities/private-parties-fundraisers.astro:88786n">
            Download a Guest List
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Booking call to action -->
  <section class="relative isolate overflow-hidden bg-dark-background text-center" data-ps="src/pages/activities/private-parties-fundraisers.astro:v4ernx">
    <img
      src={ctaImageUrl}
      alt="Roller skating party at The New Rink"
      width="360"
      height="240"
      loading="lazy"
      class="absolute inset-0 -z-10 h-full w-full object-cover" data-ps="src/pages/activities/private-parties-fundraisers.astro:knlbcq" />
    <div class="absolute inset-0 -z-10 bg-dark-background/40" aria-hidden="true" data-ps="src/pages/activities/private-parties-fundraisers.astro:hl02bq"></div>
    <div class="mx-auto flex w-full max-w-[1000px] flex-col items-center px-7 py-20 md:py-28" data-ps="src/pages/activities/private-parties-fundraisers.astro:hl02bp">
      <p class="text-sm font-semibold uppercase tracking-[0.28px] text-border" data-ps="src/pages/activities/private-parties-fundraisers.astro:fc54we">
        Fun with family, friends, co-workers, and more
      </p>
      <h2 class="mt-5 font-display text-[clamp(2rem,1.4rem+2.6vw,3.5625rem)] leading-[1.2] text-white" data-ps="src/pages/activities/private-parties-fundraisers.astro:a7kqcr">
        Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.
      </h2>
      <p class="mt-6 text-lg leading-[27px] text-white/90" data-ps="src/pages/activities/private-parties-fundraisers.astro:fc54wd">
        We have many packages to make your party a memorable and fun event.
      </p>
      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener"
        class="mt-9 inline-block rounded bg-primary px-7 py-3.5 text-lg font-semibold text-white transition-colors hover:bg-primary-hover"
       data-ps="src/pages/activities/private-parties-fundraisers.astro:88786m">
        Book a Party Now
      </a>
    </div>
  </section>
</BaseLayout>
