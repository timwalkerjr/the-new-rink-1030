---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Rollers and Strollers – The New Rink';
const pageDescription =
  'Activities at The New Rink Rollers and Strollers. Enjoy time playing or skating to your favorite children’s music. During these sessions parents are allowed on the skating surface with street shoes and may also push strollers.';
---

<BaseLayout title={pageTitle} description={pageDescription} headerVariant="transparent">
  <section class="bg-[#550172] pt-40 pb-16 text-white md:pb-20" data-ps="src/pages/activities/rollers-and-strollers.astro:bgcyz1">
    <div class="mx-auto max-w-[1344px] px-7" data-ps="src/pages/activities/rollers-and-strollers.astro:1xamqm">
      <p class="text-sm font-normal text-[#fcc4a1] md:text-base" data-ps="src/pages/activities/rollers-and-strollers.astro:s4sniq">Activities at The New Rink</p>
      <h1 class="mt-3 text-h1 font-bold text-white" data-ps="src/pages/activities/rollers-and-strollers.astro:gcp0w5">Rollers and Strollers</h1>
    </div>
  </section>

  <section class="bg-[#f3f3f3] py-16 md:py-28" data-ps="src/pages/activities/rollers-and-strollers.astro:bgcyz0">
    <div class="mx-auto grid max-w-[1344px] gap-10 px-7 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-16" data-ps="src/pages/activities/rollers-and-strollers.astro:1xamqn">
      <div class="min-w-0 text-base leading-[1.7] text-[#404040]" data-ps="src/pages/activities/rollers-and-strollers.astro:1xamqo">
        <p data-ps="src/pages/activities/rollers-and-strollers.astro:s4sni4">
          Enjoy time playing or skating to your favorite children’s music. During these sessions parents are allowed on the skating surface with street shoes and may also push strollers. Push toys or ride-on toys may be brought in for use on the floor for those children that do not wish to skate. Bounce Zone is also included at this time. <strong>Please no toys with pedals.</strong>
        </p>
        <p class="mt-4 font-semibold" data-ps="src/pages/activities/rollers-and-strollers.astro:s4sni3">Every Saturday from 10:00 a.m. to 12:00 p.m.</p>
        <ul class="my-5 list-disc space-y-1.5 pl-6">
          <li data-ps="src/pages/activities/rollers-and-strollers.astro:2f906b">All <strong><em>Walking</em></strong> Preschoolers &amp; <strong>Skating</strong> Adults includes skate rental, snack &amp; beverage: $10.00</li>
          <li data-ps="src/pages/activities/rollers-and-strollers.astro:2f906c">Non-Walking Infants in Strollers: $1.00</li>
          <li data-ps="src/pages/activities/rollers-and-strollers.astro:2f906d">Non-Skating Adults: No Charge</li>
          <li data-ps="src/pages/activities/rollers-and-strollers.astro:2f906e">Group Rate for 15 or more (with signed agreement): $7.50</li>
        </ul>
        <h2 class="mt-10 text-h2 font-bold uppercase leading-tight text-[#550172]" data-ps="src/pages/activities/rollers-and-strollers.astro:1oa3oj">UPCOMING EVENTS</h2>
        <p class="mt-4" data-ps="src/pages/activities/rollers-and-strollers.astro:s4sni2">
          <img
            class="h-auto w-full"
            src="https://pagesmith-cdn.com/0b4329bf/images/Sonic-Skate-26-1024x512-1-0f0fa5-1024.webp"
            alt="Sonic Skate flyer"
            width="1024"
            height="512"
            loading="lazy" data-ps="src/pages/activities/rollers-and-strollers.astro:dv7lce" />
        </p>
      </div>

      <aside class="mx-auto w-full self-start md:max-w-md lg:mx-0 lg:max-w-none" data-ps="src/pages/activities/rollers-and-strollers.astro:ibcdf8">
        <img
          class="aspect-[3/4] w-full rounded-lg object-cover"
          src="https://pagesmith-cdn.com/0b4329bf/images/IMG_8993-rotated-1-1-5baa7c-1536.webp"
          alt="Rollers and Strollers at The New Rink"
          width="1536"
          height="2048"
          loading="lazy" data-ps="src/pages/activities/rollers-and-strollers.astro:dv7lcd" />
      </aside>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-[#270034] py-24 text-center text-white md:py-28" data-ps="src/pages/activities/rollers-and-strollers.astro:bgcyyz">
    <img
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp"
      alt="Roller skating party at The New Rink"
      width="360"
      height="240"
      loading="lazy" data-ps="src/pages/activities/rollers-and-strollers.astro:rxybwr" />
    <div class="mx-auto max-w-[1344px] px-7" data-ps="src/pages/activities/rollers-and-strollers.astro:1xamqp">
      <div class="mx-auto max-w-5xl" data-ps="src/pages/activities/rollers-and-strollers.astro:1xamqq">
        <p class="text-sm font-semibold uppercase tracking-[0.28px] text-[#fcc4a1]" data-ps="src/pages/activities/rollers-and-strollers.astro:s4sni1">
          Fun with family, friends, co-workers, and more
        </p>
        <h2 class="mt-4 text-[clamp(2rem,1.4rem+2.8vw,57px)] font-bold leading-[1.2] text-white" data-ps="src/pages/activities/rollers-and-strollers.astro:1oa3ok">
          Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.
        </h2>
        <p class="mt-6 text-lg leading-[1.5] text-white/90" data-ps="src/pages/activities/rollers-and-strollers.astro:s4sni0">
          We have many packages to make your party a memorable and fun event.
        </p>
        <a
          class="mt-8 inline-block rounded bg-primary px-7 py-3.5 text-lg font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
          href="https://thenewrink.pcsparty.com/bookings/index.asp"
          target="_blank"
          rel="noopener"
         data-ps="src/pages/activities/rollers-and-strollers.astro:l0uqsx">
          Book a Party Now
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
