---
import BaseLayout from '@/layouts/BaseLayout.astro';

const heroImage = 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp';
const guestListPdf = 'https://thenewrink.com/wp-content/uploads/2026/09/The-New-Rink-Guest-List-Online-2023.pdf';
const bookingUrl = 'https://thenewrink.pcsparty.com/bookings/index.asp';

const included = [
  'Private Two-Hour Session',
  'Admission for up to 50 people',
  '8 Whole Pizzas & unlimited Pitchers of Pop (served buffet style)',
  'Roller Skate or Roller Blade Rental if needed',
  'A Fun & Friendly Host to Help with Your Party',
  'You may bring your own cake',
  'Additional guests $15.00 per person',
  'Additional hour may be added to your party for $300',
  'Add the BOUNCE ZONE to your skate party for $300',
];
---

<BaseLayout
  headerVariant="transparent"
  title="Private Smaller Group Parties – The New Rink"
  description="Activities at The New Rink Private Smaller Group Parties. Rent the Rink OR Bounce Zone exclusively for your party! $995 Rink Rental includes a private two-hour session for up to 50 people."
>
  <section class="bg-dark-background pt-[150px] pb-[72px] lg:pt-[190px]" data-ps="src/pages/activities/private-smaller-group-parties.astro:tp5laq">
    <div class="mx-auto w-full max-w-[1344px] px-7" data-ps="src/pages/activities/private-smaller-group-parties.astro:7ib8mf">
      <p class="text-[14px] leading-[19.6px] font-normal" style="color: hsl(23 93% 60%)" data-ps="src/pages/activities/private-smaller-group-parties.astro:bfsg0n">Activities at The New Rink</p>
      <h1 class="mt-3 text-h1 font-normal leading-[1.2] text-white" data-ps="src/pages/activities/private-smaller-group-parties.astro:6vsfvv">Private Smaller Group Parties</h1>
    </div>
  </section>

  <section class="bg-[#f3f3f3] py-16 md:py-28" data-ps="src/pages/activities/private-smaller-group-parties.astro:tp5lap">
    <div class="mx-auto grid w-full max-w-[1344px] gap-12 px-7 lg:grid-cols-[1fr_427px] lg:gap-16" data-ps="src/pages/activities/private-smaller-group-parties.astro:7ib8me">
      <div class="prose max-w-none text-foreground" data-ps="src/pages/activities/private-smaller-group-parties.astro:7ib8md">
        <p class="text-[16px] leading-[27px] font-semibold text-foreground" data-ps="src/pages/activities/private-smaller-group-parties.astro:bfsg0m">Rent the Rink OR Bounce Zone exclusively for your party!</p>
        <h2 class="mt-4 text-[40px] leading-[50px] font-normal text-black" data-ps="src/pages/activities/private-smaller-group-parties.astro:7smhbs">$995 Rink Rental includes:</h2>
        <ul class="mt-4 list-disc space-y-1.5 pl-6 text-[16px] leading-[27.2px] text-[#404040]">
          {included.map((item) => <li data-ps="src/pages/activities/private-smaller-group-parties.astro:71nktx">{item}</li>)}
        </ul>
        <p class="mt-6 text-[16px] leading-[27px] font-semibold text-foreground" data-ps="src/pages/activities/private-smaller-group-parties.astro:bfsg0l">$100.00 Deposit Required, Several Food Options Available</p>
      </div>

      <aside class="flex flex-col" data-ps="src/pages/activities/private-smaller-group-parties.astro:a8975l">
        <img
          src={heroImage}
          alt="Roller skating party at The New Rink"
          width="360"
          height="240"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] w-full rounded-lg object-cover" data-ps="src/pages/activities/private-smaller-group-parties.astro:m6ldns" />
        <h2 class="mt-8 text-[30px] leading-[39px] font-normal text-black" data-ps="src/pages/activities/private-smaller-group-parties.astro:7smhbr">Necessary Documents</h2>
        <div class="mt-6" data-ps="src/pages/activities/private-smaller-group-parties.astro:7ib8mc">
          <a
            href={guestListPdf}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center rounded-full bg-primary px-7 py-3.5 text-[14px] font-semibold tracking-[0.5px] text-primary-foreground transition-colors hover:bg-primary-hover"
           data-ps="src/pages/activities/private-smaller-group-parties.astro:4bujbg">
            Party Guest List
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-dark-background py-28" data-ps="src/pages/activities/private-smaller-group-parties.astro:tp5lao">
    <img
      src={heroImage}
      alt="Roller skating party at The New Rink"
      width="360"
      height="240"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-60" data-ps="src/pages/activities/private-smaller-group-parties.astro:xnjupc" />
    <div class="mx-auto flex w-full max-w-[1344px] flex-col items-center px-7 text-center" data-ps="src/pages/activities/private-smaller-group-parties.astro:7ib8mb">
      <p class="text-[14px] leading-[19.6px] font-semibold uppercase tracking-[0.28px]" style="color: hsl(23 94% 81%)" data-ps="src/pages/activities/private-smaller-group-parties.astro:bfsg0k">
        Fun with family, friends, co-workers, and more
      </p>
      <h2 class="mt-4 max-w-[1000px] text-[clamp(2.25rem,1.4rem+3.2vw,57px)] leading-[1.2] font-normal text-white" data-ps="src/pages/activities/private-smaller-group-parties.astro:7smhbq">
        Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.
      </h2>
      <p class="mt-6 text-[18px] leading-[27px] text-white/90" data-ps="src/pages/activities/private-smaller-group-parties.astro:bfsg0j">
        We have many packages to make your party a memorable and fun event.
      </p>
      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center rounded-[4px] bg-primary px-7 py-3.5 text-[18px] leading-[25.2px] font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
       data-ps="src/pages/activities/private-smaller-group-parties.astro:4bujbf">
        Book a Party Now
      </a>
    </div>
  </section>
</BaseLayout>
