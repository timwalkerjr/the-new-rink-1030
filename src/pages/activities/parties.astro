---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Parties – The New Rink"
  description="There’s Always A Reason To Party! Birthdays, Scout Outings, Get Togethers, Sports Teams, Any Celebrations. Three Party Packages to Choose From."
  headerVariant="transparent"
>
  <section class="bg-accent pt-32 pb-14 text-white" data-ps="src/pages/activities/parties.astro:aljoho">
    <div class="mx-auto max-w-[1344px] px-7" data-ps="src/pages/activities/parties.astro:tb78ux">
      <p class="text-[15px] text-border" data-ps="src/pages/activities/parties.astro:qdfwot">Activities at The New Rink</p>
      <h1 class="mt-3 text-h1 text-white" data-ps="src/pages/activities/parties.astro:nlv70m">Parties</h1>
    </div>
  </section>

  <section class="bg-[#f3f3f3] py-16 md:py-20" data-ps="src/pages/activities/parties.astro:aljohp">
    <div class="mx-auto grid max-w-[1344px] grid-cols-1 gap-12 px-7 lg:grid-cols-[minmax(0,1fr)_427px] lg:gap-16" data-ps="src/pages/activities/parties.astro:tb78uw">
      <div class="parties-body min-w-0" data-ps="src/pages/activities/parties.astro:tb78uv">
        <p data-ps="src/pages/activities/parties.astro:qdfwou">There’s Always A Reason To Party! Birthdays, Scout Outings, Get Togethers, Sports Teams, Any Celebrations. Three Party Packages to Choose From.</p>
        <p data-ps="src/pages/activities/parties.astro:qdfwov">*Cake and Party Supplies may ONLY be brought into the building when a Party is BOOKED*</p>
        <p data-ps="src/pages/activities/parties.astro:qdfwow">*For all parties without private room, dining area may be shared with up to two other parties.</p>

        <h2 data-ps="src/pages/activities/parties.astro:wqtxqt"><img alt="New" height="219" src="https://pagesmith-cdn.com/0b4329bf/images/New-Clip-Art-2192-297f00-1200.webp" width="131" data-ps="src/pages/activities/parties.astro:c8yysn">7 &amp; Under Preschool Package (Skating and Bounce Party): $199.95 includes Birthday Child and the first 9 guests (prior to tax)&nbsp; ****<span class="text-[#ff0000]" data-ps="src/pages/activities/parties.astro:eppofe">SATURDAY MORNINGS 10AM – 12PM ONLY</span>****</h2>
        <hr>
        <h3 data-ps="src/pages/activities/parties.astro:i2f0ij">PRESCHOOL PACKAGE INCLUDES:</h3>
        <p data-ps="src/pages/activities/parties.astro:qdfwox"><strong>2 Hour Party&nbsp; *(Parents- this is the only time you can walk on the floor with your child in shoes.&nbsp; Strollers also welcome on the floor at this time)</strong></p>
        <ul>
          <li data-ps="src/pages/activities/parties.astro:xhsu2p">Admission</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu2q">Choice of Rentals (for Skating Party)</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu2r">Up to 10 Skate Mate Trainers</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu2s">Bounce Zone</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu2t">Slice of Pepperoni Pizza</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3f">Beverage</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3g">Ice Cream Cup</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3h">Decorative Paper Products</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3i">1 Hour Reserved Table in Shared Birthday Room + 2 Meet and Greet Tables (Skating Party Only)</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3j">Bounce Party Reserved Table in Bounce Zone</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3k">Birthday Child receives 500 Stuff Shop Points</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3l">Free Pass for Future Skating Session for Each Guest</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3m">You May Bring In Your Own Cake</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3n">A Fun &amp; Friendly Host to Serve Your Party</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu3o"><strong>$19.95 Per Person for Additional Guests</strong></li>
        </ul>
        <p data-ps="src/pages/activities/parties.astro:qdfwoy">Arrival Time for set up 10 minutes before scheduled party start time</p>

        <h2 data-ps="src/pages/activities/parties.astro:wqtxqu">Classic Package (Skating Party OR Bounce Party): $249.95 includes Birthday Child and the first 9 guests (prior to tax)</h2>
        <hr>
        <h3 data-ps="src/pages/activities/parties.astro:i2f0ik">CLASSIC PACKAGE INCLUDES:</h3>
        <p data-ps="src/pages/activities/parties.astro:qdfwoz"><strong>3 Hour Party</strong></p>
        <ul>
          <li data-ps="src/pages/activities/parties.astro:xhsu4a">Admission</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4b">Choice of Rentals (for Skating Party)</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4c">Slice of Pepperoni Pizza</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4d">Beverage</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4e">Ice Cream Cup</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4f">Decorative Paper Products</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4g">1 Hour Reserved Table in Shared Birthday Room + 2 Meet and Greet Tables (Skating Party Only)</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4h">Bounce Party Reserved Table in Bounce Zone</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4i">Birthday Child receives 500 Stuff Shop Points</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu4j">Free Pass for Future Skating Session for Each Guest</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu55">You May Bring In Your Own Cake</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu56">A Fun &amp; Friendly Host to Serve Your Party</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu57"><strong>$19.95 Per Person for Additional Guests</strong></li>
          <li data-ps="src/pages/activities/parties.astro:xhsu58"><strong>SKATE MATE RENTAL $5.00 ADDITIONAL PER SKATE MATE</strong></li>
        </ul>
        <p data-ps="src/pages/activities/parties.astro:qdfwp0">Arrival Time for set up 10 minutes before scheduled party start time</p>

        <h2 data-ps="src/pages/activities/parties.astro:wqtxqv">Deluxe Skating Package: $279.95 for Birthday Child and the first 9 guests (prior to tax)</h2>
        <hr>
        <h3 data-ps="src/pages/activities/parties.astro:i2f0il">DELUXE SKATING PACKAGE INCLUDES:</h3>
        <p data-ps="src/pages/activities/parties.astro:qdfwp1"><strong>3 Hour Party</strong></p>
        <ul>
          <li data-ps="src/pages/activities/parties.astro:xhsu59">Admission</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu5a">Choice of Rentals</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu5b">PLUS Admission to the Bounce Zone</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu5c">Slice of Pepperoni Pizza</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu5d">Beverage</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu5e">Ice Cream Cup</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu60">Decorative Paper Products</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu61">1 Hour Reserved Table in Shared Birthday Room + 2 Meet and Greet Tables</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu62">Birthday Child receives 500 Stuff Shop Points</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu63">Free Pass for Future Skating Session for Each Guest</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu64">You May Bring In Your Own Cake</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu65">A Fun &amp; Friendly Host to Serve Your Party</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu66"><strong>$24.95 Per Person for Additional Guests</strong></li>
          <li data-ps="src/pages/activities/parties.astro:xhsu67"><strong>SKATE MATE RENTAL $5.00 ADDITIONAL PER SKATE MATE</strong></li>
        </ul>
        <p data-ps="src/pages/activities/parties.astro:qdfwpn">Arrival Time for set up 10 minutes before scheduled party start time</p>

        <h3 data-ps="src/pages/activities/parties.astro:i2f0im">EXTRAS:</h3>
        <hr>
        <ul>
          <li data-ps="src/pages/activities/parties.astro:xhsu68">Bowl of Popcorn $5.00</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu69">Cheese or Pepperoni Pizza $16 for 8 slices</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu6v">Chicken Tenders $34.95 (serves up to 7)</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu6w">Breadsticks (10 count w/ pizza sauce) $10.95</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu6x">Antipasto Salad $24.95 (serves up to 7)</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu6y">Garden Salad $18.95 (serves up to 7)</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu6z">Pitchers of Pop $6.00</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu70">Ice Cream Cups $2.00</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu71">Pair of Adjustable Skates for Birthday Child $50.00 ($65.95 value)</li>
        </ul>

        <h3 data-ps="src/pages/activities/parties.astro:i2f0j8">*NEW* Add a Bundle To Your Party Package!!</h3>
        <hr>
        <ul>
          <li data-ps="src/pages/activities/parties.astro:xhsu72">Gamer Glow Bundle $50: 10 $5 Game Cards and 10 Glow Sticks ($60 value)</li>
          <li data-ps="src/pages/activities/parties.astro:xhsu73">Hungry Skater Bundle $50: 2 Whole Pizzas, 2 Pitchers of Pop, 1 order of breadsticks ($55 value)</li>
        </ul>

        <h4 data-ps="src/pages/activities/parties.astro:3e03ay">WANT A PRIVATE ROOM WHERE YOU DON’T HAVE TO MOVE AFTER YOU EAT?</h4>
        <hr>
        <p data-ps="src/pages/activities/parties.astro:qdfwpo">Rent our Private Room for an additional $100 (seats up to 32)</p>
        <p data-ps="src/pages/activities/parties.astro:qdfwpp">Rent our Private Party Pit for an additional $125 (seats up to 50)</p>
        <p data-ps="src/pages/activities/parties.astro:qdfwpq">Rent our Detroiter Room for an additional $150 (seats up to 48)</p>
      </div>

      <aside class="min-w-0" data-ps="src/pages/activities/parties.astro:723emt">
        <img
          class="block h-auto w-full rounded-xl"
          src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-013-db936c-359.webp"
          alt="Parties at The New Rink"
          width="359"
          height="201"
          loading="lazy" data-ps="src/pages/activities/parties.astro:c8yyso" />
        <h2 class="mt-6 text-h3 text-black" data-ps="src/pages/activities/parties.astro:wqtxqw">Necessary Documents</h2>
        <div class="mt-5" data-ps="src/pages/activities/parties.astro:tb78uu">
          <a
            class="inline-block rounded-full bg-primary px-7 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-primary-hover"
            href="https://thenewrink.com/wp-content/uploads/2026/09/The-New-Rink-Guest-List-Online-2023.pdf"
            target="_blank"
            rel="noopener"
           data-ps="src/pages/activities/parties.astro:xhdte0">Download a Guest List</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-dark-background py-24 text-center text-white" data-ps="src/pages/activities/parties.astro:aljohq">
    <img
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp"
      alt="Roller skating party at The New Rink"
      width="360"
      height="200"
      loading="lazy" data-ps="src/pages/activities/parties.astro:c8yysp" />
    <div class="mx-auto max-w-[1000px] px-7" data-ps="src/pages/activities/parties.astro:tb78ut">
      <p class="text-[14px] font-semibold uppercase tracking-[0.28px] text-border" data-ps="src/pages/activities/parties.astro:qdfwpr">Fun with family, friends, co-workers, and more</p>
      <h2 class="mt-4 font-display text-[clamp(2rem,1.4rem+2.4vw,3.5rem)] leading-[1.2] text-white" data-ps="src/pages/activities/parties.astro:wqtxqx">Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.</h2>
      <p class="mt-6 text-[18px] leading-[27px] text-white/90" data-ps="src/pages/activities/parties.astro:j6iz8u">We have many packages to make your party a memorable and fun event.</p>
      <div class="mt-8" data-ps="src/pages/activities/parties.astro:tb78us">
        <a
          class="inline-block rounded-[4px] bg-primary px-7 py-3.5 text-[18px] font-semibold text-white transition-colors hover:bg-primary-hover"
          href="https://thenewrink.pcsparty.com/bookings/index.asp"
          target="_blank"
          rel="noopener"
         data-ps="src/pages/activities/parties.astro:jes79n">Book a Party Now</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .parties-body {
    font-size: 16px;
    line-height: 25.6px;
    color: var(--color-foreground);
  }
  .parties-body p {
    margin: 0 0 14px;
  }
  .parties-body h2 {
    font-family: 'ADLaM Display', var(--font-sans);
    font-weight: 400;
    font-size: clamp(1.625rem, 1.1rem + 1.8vw, 2.5rem);
    line-height: 1.2;
    color: #000;
    margin: 0 0 16px;
  }
  .parties-body h2 img {
    float: left;
    height: 13.7rem;
    width: auto;
    margin: 0 14px 6px 0;
  }
  .parties-body h3 {
    font-family: 'ADLaM Display', var(--font-sans);
    font-weight: 400;
    font-size: var(--text-h3);
    line-height: 1.3;
    color: #000;
    margin: 24px 0 12px;
  }
  .parties-body h4 {
    font-family: 'ADLaM Display', var(--font-sans);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.25;
    color: #000;
    margin: 28px 0 8px;
  }
  .parties-body hr {
    border: 0;
    border-top: 1px solid #999;
    margin: 0 0 16px;
  }
  .parties-body ul {
    list-style: disc;
    padding-left: 26px;
    margin: 0 0 16px;
  }
  .parties-body li {
    margin: 0;
  }
  .parties-body strong {
    color: #000;
    font-weight: 600;
  }
</style>
