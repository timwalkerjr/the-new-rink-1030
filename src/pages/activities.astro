---
import BaseLayout from '@/layouts/BaseLayout.astro';

const activities = [
  {
    href: '/activities/family-fun-and-exercise-for-all/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-001-c44384-402.webp',
    alt: 'Family Fun and Exercise for all at The New Rink',
    title: 'Family Fun and Exercise for all',
    text: 'Bring the entire family for fun, friend’s and exercise!!!',
  },
  {
    href: '/activities/girl-scouts/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/shutterstock_2540215587-3c7c84-1000.webp',
    alt: 'Girl Scouts at The New Rink',
    title: 'Girl Scouts',
    text: 'Bring Your Troop Roller Skating!! Ask about our annual Spectacular Scout Skate! Customized Packages for groups LARGE or Small',
  },
  {
    href: '/activities/parties/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-013-db936c-359.webp',
    alt: 'Parties at The New Rink',
    title: 'Parties',
    text: 'There’s Always A Reason To Party! Birthdays, Scout Outings, Get Togethers, Sports Teams, Any Celebrations. Three Party Packages to Choose From.',
  },
  {
    href: '/activities/private-parties-fundraisers/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-022-0e3d6a-359.webp',
    alt: 'Private Parties / Fundraisers at The New Rink',
    title: 'Private Parties / Fundraisers',
    text: "There's Always A Reason To Party! Facility is reserved solely for you and your guests. We offer day and evening parties on any open...",
  },
  {
    href: '/activities/private-smaller-group-parties/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp',
    alt: 'Roller skating party at The New Rink',
    title: 'Private Smaller Group Parties',
    text: 'Great for parties of around 50 who want to rent the rink privately. Birthdays, Sports and Team parties, Office Parties, etc!',
  },
  {
    href: '/activities/public-group-rates/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-011-4c92a6-359.webp',
    alt: 'Public Group Rates at The New Rink',
    title: 'Public Group Rates',
    text: "There's Always A Reason To Party! Standard Group Discounts: Rates valid during public sessions only (see schedule). We can accommodate groups of 15 or...",
  },
  {
    href: '/activities/rollers-and-strollers/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/IMG_8993-rotated-1-1-5baa7c-1536.webp',
    alt: 'Rollers and Strollers at The New Rink',
    title: 'Rollers and Strollers',
    text: 'Designed for children 7 & under and parents! Enjoy time playing or skating to your favorite children’s music and parents are allowed on the...',
  },
  {
    href: '/activities/school-events/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-069-9cc3fc-360.webp',
    alt: 'School Events at The New Rink',
    title: 'School Events',
    text: 'We want to help you make your party a success! We work closely with your PTO/PTA to help create a fun filled event night....',
  },
  {
    href: '/skate-lessons/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/Edruskate-learn-to-roller-skate-9026fc-500.webp',
    alt: 'Skate Lessons at The New Rink',
    title: 'Skate Lessons',
    text: 'Skate Lessons - The New Rink - Shelby Township, Michigan. Receive a coupon for 10% off skate purchases in our Pro shop when you...',
  },
  {
    href: '/events/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-068-abca97-360.webp',
    alt: 'Special Events at The New Rink',
    title: 'Special Events',
    text: 'Friday and Saturday Family Fun Nights. Skate, play, and celebrate at The New Rink.',
  },
  {
    href: '/activities/skate-pro-shop/',
    image: 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-047-13dbb2-359.webp',
    alt: 'The Pro Shop at The New Rink',
    title: 'The Pro Shop',
    text: 'Welcome to the The New Rink, Shelby Township, MI Skates Pro Shop! Roller Skates, Roller Blades, and Skate Accessories. Stop in during office hours...',
  },
];
---

<BaseLayout
  headerVariant="transparent"
  title="Activities – The New Rink"
  description="Strap on the skates and hit the rink in roller skates or roller blades. Don't know how to skate? No problem, check out our lessons and much more below."
>
  <section class="bg-secondary-foreground pt-[150px] pb-[100px] text-white" data-ps="src/pages/activities.astro:rjwaby">
    <div class="mx-auto w-full max-w-[1344px] px-7" data-ps="src/pages/activities.astro:xe1ufx">
      <p class="text-base text-border" data-ps="src/pages/activities.astro:8rd95b">Something for everyone</p>
      <h1 class="mt-2 text-h1 font-normal text-white" data-ps="src/pages/activities.astro:qj6omf">Activities</h1>
    </div>
  </section>

  <section class="bg-surface py-28" data-ps="src/pages/activities.astro:rjwabx">
    <div class="mx-auto w-full max-w-[1344px] px-7" data-ps="src/pages/activities.astro:xe1ufy">
      <div class="mx-auto max-w-[760px] text-center" data-ps="src/pages/activities.astro:xe1ufz">
        <p class="text-sm font-semibold tracking-[0.28px] text-primary uppercase" data-ps="src/pages/activities.astro:8rd95x">There is plenty of fun to go around!</p>
        <h2 class="mt-3 text-h2 font-normal text-secondary-foreground" data-ps="src/pages/activities.astro:burret">Activities to Enjoy With Us</h2>
        <p class="mt-5 text-[18px] leading-[27px] text-foreground" data-ps="src/pages/activities.astro:8rd95y">
          Strap on the skates and hit the rink in roller skates or roller blades. Don't know how to skate? No problem, check out our lessons and much more below.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-x-9 gap-y-8 md:grid-cols-2 xl:grid-cols-3" data-ps="src/pages/activities.astro:xe1ug0">
        {activities.map((item, __psIdx) => (
          <article class="flex flex-col rounded-[20px] bg-white p-5 shadow-[3px_3px_3px_3px_rgba(113,13,82,0.3)]" data-ps={`src/pages/activities.astro:dr9gcv-${__psIdx}`}>
            <a href={item.href} class="block overflow-hidden rounded-xl" data-ps={`src/pages/activities.astro:fvb5v2-${__psIdx}`}>
              <img
                src={item.image}
                alt={item.alt}
                width="384"
                height="216"
                loading="lazy"
                class="aspect-video w-full rounded-xl object-cover" data-ps={`src/pages/activities.astro:wvcq7g-${__psIdx}`} />
            </a>
            <h3 class="mt-5 text-[clamp(1.5rem,1.2rem+1vw,1.875rem)] leading-tight font-normal text-secondary-foreground" data-ps={`src/pages/activities.astro:2tn5ss-${__psIdx}`}>
              {item.title}
            </h3>
            <p class="mt-3 flex-1 text-base leading-[25.6px] text-foreground" data-ps={`src/pages/activities.astro:8rd95z-${__psIdx}`}>{item.text}</p>
            <a
              href={item.href}
              class="mt-6 inline-flex w-fit items-center rounded-full bg-primary px-7 py-3.5 text-[14px] font-semibold text-white transition-colors hover:bg-primary-hover"
             data-ps={`src/pages/activities.astro:fvb5v3-${__psIdx}`}>
              Learn More
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-dark-background py-28 text-center text-white" data-ps="src/pages/activities.astro:rjwabw">
    <img
      src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp"
      alt="Roller skating party at The New Rink"
      loading="lazy"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-60" data-ps="src/pages/activities.astro:3isvsk" />
    <div class="mx-auto w-full max-w-[1100px] px-7" data-ps="src/pages/activities.astro:xe1ug1">
      <p class="text-sm font-semibold tracking-[0.28px] text-border uppercase" data-ps="src/pages/activities.astro:8rd960">Fun with family, friends, co-workers, and more</p>
      <h2 class="mx-auto mt-4 max-w-[1000px] text-[clamp(2.25rem,1.6rem+2.6vw,3.5625rem)] leading-[1.2] font-normal text-white" data-ps="src/pages/activities.astro:burreu">
        Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.
      </h2>
      <p class="mt-6 text-[18px] leading-[27px] text-white/90" data-ps="src/pages/activities.astro:8rd961">
        We have many packages to make your party a memorable and fun event.
      </p>
      <a
        href="https://thenewrink.pcsparty.com/bookings/index.asp"
        target="_blank"
        rel="noopener"
        class="mt-10 inline-block rounded-[4px] bg-primary px-7 py-3.5 text-[18px] font-semibold text-white transition-colors hover:bg-primary-hover"
       data-ps="src/pages/activities.astro:fvb5v4">
        Book a Party Now
      </a>
    </div>
  </section>
</BaseLayout>
