---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Rollers and Strollers – The New Rink';
const pageDescription =
  'Activities at The New Rink Rollers and Strollers. Enjoy time playing or skating to your favorite children’s music. During these sessions parents are allowed on the skating surface with street shoes and may also push strollers.';
---

<BaseLayout title={pageTitle} description={pageDescription} headerVariant="transparent">
  <!-- Title band -->
  <section class="bg-[#550172] pt-36 pb-14 md:pb-20 text-white" data-ps="src/pages/activity/rollers-and-strollers.astro:5rtjgy">
    <div class="mx-auto w-full max-w-[1400px] px-7" data-ps="src/pages/activity/rollers-and-strollers.astro:es4fpf">
      <p class="text-[15px] text-border" data-ps="src/pages/activity/rollers-and-strollers.astro:x3iinb">Activities at The New Rink</p>
      <h1 class="mt-3 text-h1 font-bold leading-[1.1] text-white" data-ps="src/pages/activity/rollers-and-strollers.astro:pfhas8">Rollers and Strollers</h1>
    </div>
  </section>

  <!-- Main content -->
  <section class="bg-[#f3f3f3] py-24 md:py-28" data-ps="src/pages/activity/rollers-and-strollers.astro:5rtjgz">
    <div class="mx-auto grid w-full max-w-[1400px] gap-12 px-7 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-16" data-ps="src/pages/activity/rollers-and-strollers.astro:es4fpe">
      <div class="min-w-0" data-ps="src/pages/activity/rollers-and-strollers.astro:es4fpd">
        <p class="mb-4 text-[16px] leading-[27px] text-foreground" data-ps="src/pages/activity/rollers-and-strollers.astro:x3iinc">
          Enjoy time playing or skating to your favorite children’s music. &nbsp;During these sessions parents are allowed on the skating surface with street shoes and may also push strollers. Push toys or ride-on toys may be brought in for use on the floor for those children that do not wish to skate. Bounce Zone is also included at this time. <strong>Please no toys with pedals.</strong>
        </p>
        <p class="mb-4 text-[16px] leading-[27px] text-foreground" data-ps="src/pages/activity/rollers-and-strollers.astro:x3iind">
          <strong>Every Saturday from 10:00 a.m. to 12:00 p.m.</strong>
        </p>
        <ul class="mb-8 list-disc space-y-1 pl-6 text-[16px] leading-[27px] text-foreground">
          <li data-ps="src/pages/activity/rollers-and-strollers.astro:vo6qh3">All <strong><em>Walking</em></strong> Preschoolers &amp; <strong>Skating</strong> Adults includes skate rental, snack &amp; beverage:&nbsp; $10.00</li>
          <li data-ps="src/pages/activity/rollers-and-strollers.astro:vo6qh4">Non-Walking Infants in Strollers:&nbsp; $1.00</li>
          <li data-ps="src/pages/activity/rollers-and-strollers.astro:vo6qh5">Non-Skating Adults: No Charge</li>
          <li data-ps="src/pages/activity/rollers-and-strollers.astro:vo6qh6">Group Rate for 15 or more (with signed agreement):&nbsp; $7.50</li>
        </ul>

        <h2 class="mb-4 text-h2 font-bold uppercase leading-[1.2] text-[#550172]" data-ps="src/pages/activity/rollers-and-strollers.astro:ux7tza">UPCOMING EVENTS</h2>
        <img
          src="https://pagesmith-cdn.com/0b4329bf/images/Sonic-Skate-26-1024x512-1-0f0fa5-1024.webp"
          alt="Sonic Skate flyer"
          width="1024"
          height="512"
          loading="lazy"
          class="block h-auto w-full" data-ps="src/pages/activity/rollers-and-strollers.astro:yjebcb" />
      </div>

      <aside class="min-w-0" data-ps="src/pages/activity/rollers-and-strollers.astro:fjl3it">
        <img
          src="https://pagesmith-cdn.com/0b4329bf/images/IMG_8993-rotated-1-1-5baa7c-1536.webp"
          alt="Rollers and Strollers at The New Rink"
          width="1536"
          height="2048"
          loading="lazy"
          class="block h-auto w-full rounded-lg object-cover" data-ps="src/pages/activity/rollers-and-strollers.astro:qdqnmb" />
      </aside>
    </div>
  </section>

  <!-- Party call-to-action band -->
  <section class="relative isolate overflow-hidden bg-[#270034] py-20 md:py-24 text-white" data-ps="src/pages/activity/rollers-and-strollers.astro:5rtjh0">
    <img
      src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp"
      alt="Roller skating party at The New Rink"
      width="360"
      height="240"
      loading="lazy"
      class="absolute inset-0 -z-10 h-full w-full object-cover" data-ps="src/pages/activity/rollers-and-strollers.astro:qdqnmc" />
    <div class="mx-auto max-w-[1120px] px-7 text-center" data-ps="src/pages/activity/rollers-and-strollers.astro:es4fpc">
      <p class="text-sm font-semibold uppercase tracking-[0.28px] text-border" data-ps="src/pages/activity/rollers-and-strollers.astro:x3iine">
        Fun with family, friends, co-workers, and more
      </p>
      <h2 class="mt-5 text-[clamp(2rem,1.4rem+2.4vw,3.5625rem)] font-bold leading-[1.2] text-white" data-ps="src/pages/activity/rollers-and-strollers.astro:ux7tzb">
        Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.
      </h2>
      <p class="mt-6 text-lg leading-[27px] text-white/90" data-ps="src/pages/activity/rollers-and-strollers.astro:x3iinf">
        We have many packages to make your party a memorable and fun event.
      </p>
      <a
        href="https://thenewrink.pcsparty.com/bookings/index.asp"
        target="_blank"
        rel="noopener"
        class="mt-9 inline-block rounded-[4px] bg-primary px-7 py-3.5 text-lg font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
       data-ps="src/pages/activity/rollers-and-strollers.astro:utnmm0">
        Book a Party Now
      </a>
    </div>
  </section>
</BaseLayout>
