---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Page not found – The New Rink';
---

<BaseLayout title={pageTitle} headerVariant="transparent">
  <section class="bg-background" data-ps="src/pages/activity/activity-parties.astro:yqkcfq">
    <div class="mx-auto w-full max-w-[1136px] px-7 py-24 md:py-[200px]" data-ps="src/pages/activity/activity-parties.astro:lya825">
      <h1
        class="mb-[11px] text-[clamp(5rem,4rem+6vw,8rem)] leading-none font-bold text-secondary-foreground"
       data-ps="src/pages/activity/activity-parties.astro:dbhnbb">
        404
      </h1>
      <p class="mb-[15px] text-base text-foreground" data-ps="src/pages/activity/activity-parties.astro:7o9vpq">not found</p>
      <div class="flex" data-ps="src/pages/activity/activity-parties.astro:lya824">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          id="icon-sad"
          viewBox="0 0 32 32"
          width="16"
          height="16"
          fill="currentColor"
          aria-hidden="true"
          class="text-black"
        >
          <path
            d="M16 32c8.837 0 16-7.163 16-16s-7.163-16-16-16-16 7.163-16 16 7.163 16 16 16zM16 3c7.18 0 13 5.82 13 13s-5.82 13-13 13-13-5.82-13-13 5.82-13 13-13zM8 10c0-1.105 0.895-2 2-2s2 0.895 2 2c0 1.105-0.895 2-2 2s-2-0.895-2-2zM20 10c0-1.105 0.895-2 2-2s2 0.895 2 2c0 1.105-0.895 2-2 2s-2-0.895-2-2zM9.997 24.398l-2.573-1.544c1.749-2.908 4.935-4.855 8.576-4.855s6.827 1.946 8.576 4.855l-2.573 1.544c-1.224-2.036-3.454-3.398-6.003-3.398s-4.779 1.362-6.003 3.398z"
          />
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>
