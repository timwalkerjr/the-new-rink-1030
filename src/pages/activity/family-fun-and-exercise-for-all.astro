---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Family Fun and Exercise for all – The New Rink';
const description =
  'Bring the entire family for fun, friends and exercise at The New Rink. Fun with family, friends, co-workers, and more.';
---

<BaseLayout title={title} description={description} headerVariant="transparent">
  <!-- Hero heading band (source: purple page header) -->
  <section class="bg-[#550172] text-white" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:uwdggm">
    <div class="mx-auto max-w-[1400px] px-[28px] pt-[150px] pb-[88px] md:pt-[170px]" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:45qsr9">
      <p class="text-[16px] leading-[22px] text-border" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:m4lypd">Activities at The New Rink</p>
      <h1 class="mt-3 text-[clamp(2rem,1.2rem+3vw,48px)] leading-[1.2] font-normal text-white" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:gfag6o">
        Family Fun and Exercise for all
      </h1>
    </div>
  </section>

  <!-- Intro: heading and photo on light grey -->
  <section class="bg-[#f3f3f3] py-[112px] max-md:py-[56px]" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:uwdggl">
    <div class="mx-auto grid max-w-[1400px] items-start gap-[40px] px-[28px] md:grid-cols-2" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:45qsra">
      <div class="min-w-0" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:45qsrb">
        <h2 class="text-[clamp(1.875rem,1.4rem+1.6vw,40px)] leading-[1.25] font-normal text-black" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:1qviz2">
          Bring the entire family for fun, friend’s and exercise!!!
        </h2>
      </div>
      <div class="justify-self-end w-full max-w-[402px]" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:45qsrc">
        <img
          src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-001-c44384-402.webp"
          alt="Family Fun and Exercise for all at The New Rink"
          width="402"
          height="240"
          loading="lazy"
          class="block h-auto w-full rounded-[8px] object-cover" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:ppi5w4" />
      </div>
    </div>
  </section>

  <!-- Party call-to-action band with dimmed photo over dark purple -->
  <section class="relative isolate overflow-hidden bg-[#270034] py-[112px] max-md:py-[64px] text-white" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:uwdggk">
    <img
      src="https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp"
      alt="Roller skating party at The New Rink"
      width="360"
      height="240"
      loading="lazy"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-60" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:ppi5w3" />
    <div class="relative mx-auto flex w-full max-w-[1120px] flex-col items-center gap-[20px] px-[28px] text-center" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:45qsrd">
      <p class="text-[14px] leading-[19.6px] font-semibold uppercase text-border" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:m4lype">
        Fun with family, friends, co-workers, and more
      </p>
      <h2 class="text-[clamp(2rem,1.2rem+2.6vw,57px)] leading-[1.2] font-normal text-white" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:1qviz3">
        Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.
      </h2>
      <p class="text-[18px] leading-[27px] text-white/90" data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:m4lypf">
        We have many packages to make your party a memorable and fun event.
      </p>
      <a
        href="https://thenewrink.pcsparty.com/bookings/index.asp"
        target="_blank"
        rel="noopener"
        class="mt-[8px] inline-flex items-center rounded-[4px] bg-primary px-[28px] py-[14px] text-[18px] font-semibold leading-[25.2px] text-white transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
       data-ps="src/pages/activity/family-fun-and-exercise-for-all.astro:t8jvf6">
        Book a Party Now
      </a>
    </div>
  </section>
</BaseLayout>
