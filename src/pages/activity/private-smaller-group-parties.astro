---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const pageTitle = 'Private Smaller Group Parties – The New Rink';
const pageDescription =
  'Activities at The New Rink Private Smaller Group Parties Rent the Rink OR Bounce Zone exclusively for your party! $995 Rink Rental includes: Private Two-Hour Session, admission for up to 50 people, 8 whole pizzas and unlimited pitchers of pop.';

const partyImage = 'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-074-da421d-360.webp';
const guestListUrl = 'https://thenewrink.com/wp-content/uploads/2026/09/The-New-Rink-Guest-List-Online-2023.pdf';
const bookingUrl = 'https://thenewrink.pcsparty.com/bookings/index.asp';

const rentalIncludes = [
  'Private Two-Hour Session',
  'Admission for up to 50 people',
  '8 Whole Pizzas & unlimited Pitchers of Pop (served buffet style)',
  'Roller Skate or Roller Blade Rental if needed',
  'A Fun & Friendly Host to Help with Your Party',
  'You may bring your own cake',
  'Additional guests $15.00 per person',
  'Additional hour may be added to your party for $300',
  'Add the BOUNCE ZONE to your skate party for $300',
];
---

<BaseLayout headerVariant="transparent" title={pageTitle} description={pageDescription}>
  <!-- Page title band -->
  <section class="bg-[#550172] pt-44 pb-16 text-white md:pt-48" data-ps="src/pages/activity/private-smaller-group-parties.astro:781c1g">
    <div class="mx-auto max-w-[1344px] px-5 sm:px-7" data-ps="src/pages/activity/private-smaller-group-parties.astro:9pv9tj">
      <p class="text-[14px] leading-[19.6px] text-[#faa673] sm:text-[15px]" data-ps="src/pages/activity/private-smaller-group-parties.astro:3fl0wb">Activities at The New Rink</p>
      <h1 class="mt-3 text-h1 leading-[1.15] font-normal text-white" data-ps="src/pages/activity/private-smaller-group-parties.astro:l6pya5">Private Smaller Group Parties</h1>
    </div>
  </section>

  <!-- Rental details -->
  <section class="bg-[#f3f3f3] py-20 md:py-28" data-ps="src/pages/activity/private-smaller-group-parties.astro:781c1f">
    <div class="mx-auto grid max-w-[1344px] gap-12 px-5 sm:px-7 lg:grid-cols-[minmax(0,1fr)_427px] lg:gap-16" data-ps="src/pages/activity/private-smaller-group-parties.astro:9pv9tk">
      <div class="max-w-[760px] text-[16px] leading-[27.2px] text-[#404040]" data-ps="src/pages/activity/private-smaller-group-parties.astro:9pv9tl">
        <p class="font-bold text-[#404040]" data-ps="src/pages/activity/private-smaller-group-parties.astro:3fl0wc"><strong>Rent the Rink OR Bounce Zone exclusively for your party!</strong></p>
        <h2 class="mt-6 text-[length:var(--text-h2)] leading-[1.25] font-normal text-black" data-ps="src/pages/activity/private-smaller-group-parties.astro:6ib12i">$995 Rink Rental includes:</h2>
        <ul class="mt-4 list-disc space-y-1 pl-6">
          {rentalIncludes.map((item) => <li data-ps="src/pages/activity/private-smaller-group-parties.astro:799xkd">{item}</li>)}
        </ul>
        <p class="mt-6 font-bold text-[#404040]" data-ps="src/pages/activity/private-smaller-group-parties.astro:3fl0wd"><strong>$100.00 Deposit Required, Several Food Options Available</strong></p>
      </div>

      <aside class="w-full" data-ps="src/pages/activity/private-smaller-group-parties.astro:196o4b">
        <img
          class="block aspect-[3/2] w-full rounded-lg object-cover"
          src={partyImage}
          alt="Roller skating party at The New Rink"
          width="360"
          height="240"
          loading="lazy" data-ps="src/pages/activity/private-smaller-group-parties.astro:en848q" />
        <h2 class="mt-8 text-[length:var(--text-h3)] leading-[1.3] font-normal text-black" data-ps="src/pages/activity/private-smaller-group-parties.astro:6ib12j">Necessary Documents</h2>
        <div class="mt-6" data-ps="src/pages/activity/private-smaller-group-parties.astro:9pv9tm">
          <a
            href={guestListUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center rounded-full bg-primary px-7 py-3.5 text-[14px] leading-[21px] font-semibold tracking-[0.5px] text-primary-foreground transition-colors hover:bg-primary-hover"
           data-ps="src/pages/activity/private-smaller-group-parties.astro:ajixli">Party Guest List</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Booking call-to-action band -->
  <section class="relative isolate overflow-hidden bg-dark-background text-white" data-ps="src/pages/activity/private-smaller-group-parties.astro:781c1e">
    <img
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-55"
      src={partyImage}
      alt="Roller skating party at The New Rink"
      loading="lazy"
      aria-hidden="true" data-ps="src/pages/activity/private-smaller-group-parties.astro:k5dotu" />
    <div class="mx-auto flex max-w-[1344px] flex-col items-center px-5 py-28 text-center sm:px-7 md:py-32" data-ps="src/pages/activity/private-smaller-group-parties.astro:9pv9tn">
      <p class="text-[14px] leading-[19.6px] font-semibold tracking-[0.28px] text-[#fcc4a1] uppercase" data-ps="src/pages/activity/private-smaller-group-parties.astro:3fl0we">
        Fun with family, friends, co-workers, and more
      </p>
      <h2 class="mt-4 max-w-[960px] text-[length:var(--text-h-cta,clamp(2.25rem,1.5rem+3vw,3.5625rem))] leading-[1.2] font-normal text-white" data-ps="src/pages/activity/private-smaller-group-parties.astro:6ib12k">
        Schedule your next Birthday, Scout Outing, Get Together, Sports Team, Celebrations, and much more.
      </h2>
      <p class="mt-6 text-[18px] leading-[27px] text-white/90" data-ps="src/pages/activity/private-smaller-group-parties.astro:3fl0wf">
        We have many packages to make your party a memorable and fun event.
      </p>
      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener"
        class="mt-10 inline-flex items-center justify-center rounded-[4px] bg-primary px-7 py-3.5 text-[18px] leading-[25.2px] font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
       data-ps="src/pages/activity/private-smaller-group-parties.astro:ajixlj">Book a Party Now</a>
    </div>
  </section>
</BaseLayout>
