---
// Our Image Gallery: 15 photos in a 5-column grid, original images, no overlay.
const photos = [
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-068-1-e12556-360.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-026-967daf-359.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-073-e5208c-360.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-069-1-3d5a17-360.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-049-3cee5e-359.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-041-a6a66f-359.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-034-ea6b8c-359.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-030-79de35-359.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-022-1-4d5e56-359.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-007-493bf0-359.webp',
  'https://pagesmith-cdn.com/0b4329bf/images/the-new-rink-017-7f3652-359.webp',
