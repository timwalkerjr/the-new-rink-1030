---

<section id="gallery" class="bg-white px-[28px] py-[72px] md:py-[112px]" data-ps="src/components/home/Gallery.astro:svckgn">
  <div class="mx-auto max-w-[1344px]" data-ps="src/components/home/Gallery.astro:hoiz9u">
    <div class="mx-auto max-w-[760px] text-center" data-ps="src/components/home/Gallery.astro:hoiz9v">
      <p class="text-[16px] font-semibold tracking-[0.32px] text-primary" data-ps="src/components/home/Gallery.astro:ijiq9d">Join the Fun with Us!</p>
      <h2 class="mt-[8px] text-[32px] leading-[1.2] font-normal text-black md:text-[43px] md:leading-[51.6px]" data-ps="src/components/home/Gallery.astro:gc6k3t">Our Image Gallery</h2>
      <p class="mt-[16px] text-[18px] leading-[27px] text-foreground" data-ps="src/components/home/Gallery.astro:ijiq9c">
        Come skate, bounce, and make memories with family and friends at The New Rink.
      </p>
    </div>
    <div class="mt-[56px] grid grid-cols-2 gap-[8px] sm:grid-cols-3 lg:grid-cols-5" data-ps="src/components/home/Gallery.astro:hoiz9w">
      {photos.map((src, __psIdx) => (
        <img src={src} alt="Roller skating at The New Rink in Shelby Township" width="360" height="240" loading="lazy" class="aspect-square w-full object-cover" data-ps={`src/components/home/Gallery.astro:c6pzdg-${__psIdx}`} />
      ))}
    </div>
  </div>
</section>
